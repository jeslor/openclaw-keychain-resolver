{
  "name": "openclaw-keychain-resolver",
  "version": "1.2.0",
  "description": "Native OS keychain SecretRef resolver for OpenClaw — macOS Keychain, libsecret, Windows DPAPI",
  "main": "dist/resolver.js",
  "configSchema": {
    "type": "object",
    "properties": {}
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "openclaw-keychain-resolver": "./dist/resolver.js",
    "ckg": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/resolver.js dist/cli.js",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/resolver.ts",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeslor/openclaw-keychain-resolver.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "keychain",
    "secrets",
    "security"
  ],
  "author": "Jeslor Ssozi",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    },
    "extensions": [
      "./dist/resolver.js"
    ]
  },
  "bugs": {
    "url": "https://github.com/jeslor/openclaw-keychain-resolver/issues"
  },
  "homepage": "https://github.com/jeslor/openclaw-keychain-resolver#readme",
  "dependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
